% arxiv.sty - Style for arXiv preprints
% Based on NIPS 2018 style with modifications for preprint use
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2024/01/01 arXiv preprint style]

% Fonts and encoding
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}

% Page geometry
\RequirePackage[
  letterpaper,
  top=1in,
  bottom=1in,
  left=1in,
  right=1in
]{geometry}

% Math
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsfonts}

% Graphics and tables
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{xcolor}

% References and links
\RequirePackage[
  colorlinks=true,
  linkcolor=blue!70!black,
  citecolor=blue!70!black,
  urlcolor=blue!70!black
]{hyperref}
\RequirePackage[numbers,sort&compress]{natbib}

% Captions
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage{subcaption}

% Misc
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{abstract}

% Section formatting
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Header
\setlength{\headheight}{13.6pt}
\addtolength{\topmargin}{-1.6pt}
\pagestyle{fancy}
\fancyhf{}
\rhead{\thepage}
\lhead{\textit{Preprint}}
\renewcommand{\headrulewidth}{0pt}

% Title formatting
\newcommand{\@arxivid}{}
\newcommand{\arxivid}[1]{\renewcommand{\@arxivid}{#1}}

% Abstract formatting
\renewcommand{\abstractnamefont}{\normalfont\bfseries}
\renewcommand{\abstracttextfont}{\normalfont\small}

% Paragraph spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}

% Table spacing
\renewcommand{\arraystretch}{1.2}

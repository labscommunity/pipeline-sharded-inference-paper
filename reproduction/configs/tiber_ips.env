# Tailscale IPs of the Tiber Cloud AI PCs used in the paper.
# These are stable (set when the node first joined the tailnet).
# If you redeploy on a different tailnet, update these to match `tailscale status`.

# 70B 4-stage deployment
MATIAS_01_TS_IP=100.88.94.47    # 4-stage stage_0 + LL coord
MATIAS_02_TS_IP=100.77.178.45   # 4-stage stage_1 worker
PAWAN_01_TS_IP=100.127.88.82    # 4-stage stage_2 worker
PAWAN_02_TS_IP=100.75.226.6     # 4-stage stage_3 worker
TATE_04_TS_IP=                  # PL coord variant (assigned at join — fill in after `tailscale status`)

# 7-stage paired deployment (historical; failed on Arrow Lake)
TATE_01_TS_IP=100.113.0.105     # Arrow Lake — Xe-LPG died on 12-layer 70B INT4 stage
TATE_02_TS_IP=100.88.34.75      # Arrow Lake
